PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (create a free cluster at mongodb.com/atlas)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/campuscart?retryWrites=true&w=majority

# JWT secret - generate a long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=1h

# Comma separated list of allowed origins for CORS (your deployed frontend URL)
CORS_ORIGIN=http://localhost:3000
